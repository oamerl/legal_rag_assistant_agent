# ── Device Configuration ──────────────────────────────────────────────
# Options: "cpu" or "cuda"
DEVICE=cpu

# ── Embedding Configuration ───────────────────────────────────────────
# Options: "local" (FastEmbed/ONNX), 
#          "voyage" (Voyage AI API),
#          "openrouter" (remote dense via OpenRouter + local SPLADE++)
EMBEDDING_PROVIDER=openrouter

# Local models (used when EMBEDDING_PROVIDER=local)
DENSE_MODEL_NAME=BAAI/bge-large-en-v1.5
SPARSE_MODEL_NAME=prithivida/Splade_PP_en_v1

# Voyage AI (used when EMBEDDING_PROVIDER=voyage)
VOYAGE_API_KEY=
VOYAGE_MODEL_NAME=voyage-law-2

# OpenRouter Embedding (set EMBEDDING_PROVIDER=openrouter to use)
# Uses the same OPENROUTER_API_KEY and OPENROUTER_BASE_URL as the LLM
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large
# Optional: set explicit dimensions (e.g. 512 for text-embedding-3-small)
# OPENROUTER_EMBEDDING_DIMENSIONS=

# ── Reranker Configuration ────────────────────────────────────────────
# Options: "local" or "openrouter"
RERANKER_PROVIDER=openrouter

# Local reranker (used when RERANKER_PROVIDER=local)
# Options: "BAAI/bge-reranker-large", "BAAI/bge-reranker-base", ...
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# OpenRouter reranker (used when RERANKER_PROVIDER=openrouter)
OPENROUTER_RERANKER_MODEL=cohere/rerank-v3.5
RERANKER_TOP_N=8
RERANKER_RELEVANCE_THRESHOLD=0.1

# ── LLM Configuration (OpenRouter) ────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o
LLM_MODEL_SMALL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ── Evaluation ─────────────────────────────────────────────────────────
# Enable/disable the faithfulness guard (RAGAS evaluation) stage.
# Set to false to skip post-generation verification and reduce latency.
ENABLE_FAITHFULNESS_GUARD=true

# ── Chunking Configuration ────────────────────────────────────────────
# None = auto-derive from tokenizer
# CHUNK_MAX_TOKENS=
CHUNK_MERGE_PEERS=true

# ── Retrieval Configuration ───────────────────────────────────────────
RETRIEVAL_TOP_K=20
# Set to None to disable context window overflow protection
# CONTEXT_MAX_TOKENS=

# ── Qdrant Configuration ─────────────────────────────────────────────
QDRANT_COLLECTION_NAME=legal_docs

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
